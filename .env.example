# Токен бота
MAX_BOT_TOKEN=Здесь_должен_быть_токен_твоего_макс_бота
# Идентификатор владельца
MAX_BOT_ID=Здесь_идентификатор_владельца_бота
# Ключ обращения к DeepSeek
DEEPSEEK_API_KEY=Здесь_ключ_к_модели
# Имя модели
DEEPSEEK_MODEL=deepseek-v4-flash
# Путь к базе знаний (текстовому файлу с разметкой Markdown)
KB_NAME=vector_base/sorting.txt
# Каталог, в котором будет находиться векторная база знаний
DB_FAISS_DIR=vector_base
# Имя векторной базы знаний
DB_FAISS_NAME=sorting
# Системная инструкция обращения к большой речевой модели
START_TEXT=Данный бот предназначен для распознавания рукописного текста. Возьми файлы с картинками рукописного текста, напиши инструкцию для корректировки результата и отправь.